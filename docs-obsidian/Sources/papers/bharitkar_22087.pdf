jQuery(document).ready(function($) {
      // Loop through each accordion item
      $(".elementor-accordion .elementor-accordion-item").each(function() {
        let tabTitle = $(this).find(".elementor-tab-title");
        let titleContent = tabTitle.text().trim();

        // Check if the title is empty and hide the tab if true
        if (titleContent === "") {
          $(this).hide();
        }
      });
