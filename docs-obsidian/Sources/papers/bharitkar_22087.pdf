document.addEventListener("DOMContentLoaded", function() {
    // Get the current URL path
    var path = window.location.pathname;

    // Check if the path includes "/publications/"
    if (path.includes("/publications/")) {
        // Get the element with ID "menu-item-11265"
        var menuItem = document.getElementById("menu-item-11265");

        // If the element exists, add the "ubermenu-active" class
        if (menuItem) {
            menuItem.classList.add("ubermenu-active");
        }
    }
});


