<script>
/* Default comment here */ 
jQuery(document).ready(function($) {
    var scriptURL = "https://aes2026avarigconference.sched.com/js/embed.js";
	var tiempoEspera = 10000; 
    
    if ($('#sched-embed').length) {
        $.getScript(scriptURL, function() {
            var fixHeight = setInterval(function() {
                var $iframe = $('#sched-iframe iframe');
                if ($iframe.length) {
                    // Esto fuerza la eliminación de la regla de los 23000px
                    $iframe.attr('style', function(i, s) {
                        return (s || '').replace(/height[^;]+;?/g, 'height: 800px !important;');
                    });
                    clearInterval(fixHeight);
                }
            }, 500);
        });
    }
    //We display the date on the schedule
    var hoy = new Date();
    fechaFinal = hoy.toISOString().split('T')[0];
    $('#sched-embed').attr('href', "https://aes2026avarigconference.sched.com/" + fechaFinal);
});
</script>
