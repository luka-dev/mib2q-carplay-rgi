<style>
.logout-container {
	position: fixed;
	bottom: 0;
	right: 0;
	margin: 10px;
	text-align: center;
	background-color: #ffffff;
	box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
	padding: 10px;
	border-radius: 2px;
	z-index: 999;
	width: 370px;
}
.logout-container p {
	margin: 0;
	padding: 5px;
	font-size: 13px;
	line-height: 1.3;
}
.logout-btn {
	background-color:#1DDEBA !important; 
	border: none !important;
	padding: 5px;
	font-size: 16px;
	cursor: pointer;
	margin-top: 10px;
	width: 100%;
    display: block;
    outline: none;
    transition: background-color 0.3s ease; 
    border: 2px solid transparent;
}
.logout-btn:hover {
	background-color: #00E6A5;
}
</style>

<div id="showLogoutModule"  style="display:none;" class="logout-container">
	<p>You are currently logged in as an <br> Institutional Subscriber.</p>
	<p>If you would like to logout, <br> please click on the button below.</p>
	<form action="logout-institutions"  class="logout-institutions" method="post">
		<input type="text" name="action" value="formInstLogout" hidden/>
		<button type="submit" class="logout-btn">Logout</button>
	</form>
</div>

<script>

jQuery(document).ready(function($) {
    $('form.logout-institutions').on('submit', function(e) {
        e.preventDefault();

        var formData = $(this).serialize();

        $.ajax({
            type: 'POST',
            url: ajaxurl,
			data: formData,
            success: function(response) {
                console.log(response);
				window.location.reload();
            },
            error: function(xhr, status, error) {
                console.log('Err: ' + error);
            }
        });
    });
});

</script>		<header data-elementor-type="header" data-elementor-id="1216" class="elementor elementor-1216 elementor-location-header" data-elementor-post-type="elementor_library">
