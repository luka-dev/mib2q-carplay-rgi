               brColor = "#10748E";
            }
           else if(catslug=='resources'){
               brColor = "#1BBAF2";
            }
           else if(catslug=='standards'){
               brColor = "#5C4FF6";
            }
          else if(catslug=='convention'){
               brColor = "#9b37f6";
            }
          else if(catslug=='training-development'){
               brColor = "#53B7ED";
            }
            else if(catslug=='conferences'){
               brColor = "#9B37F6";
            }
           jQuery('.single-news .custom_category h6').css("border-bottom","2px solid "+brColor);
        }
	};
  
