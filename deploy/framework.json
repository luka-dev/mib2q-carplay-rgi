{
	"nodes":{
		"mmx":{
			"transport":{
				"comm":{
					"mmx":{
						"mode":"resman",
						"serializer":"BE",
						"resman":{
							"root_path":"/dev/eso"
						}
					},
					"sdis":{
						"mode":"ssl",
						"serializer":"BE",
						"ssl":{
							"address":"10.173.189.1",
							"ciphers" : "ECDHE-RSA-AES256-SHA",
							"ec_name" : "prime256v1",
							"server" : {
								"ca" : "/etc/eso/certs/sdis.pem",
								"cert" : "/etc/eso/certs/mib2-1-cert.pem"
							}
						}
					},
					"*":{
						"mode":"tcpip",
						"serializer":"BE",
						"tcpip":{
							"address":"10.0.0.15"
						}
					}
				},
				"rdi2hmi":{
					"*":{
							"mode":"ssl",
							"serializer":"BE",
							"ssl":{
								"address":"hotspot.mibhigh",
								"ciphers" : "ECDHE-RSA-AES256-SHA",
								"ec_name" : "prime256v1",
								"server" : {
									"ca" : "/etc/eso/certs/sdis.pem",
									"cert" : "/etc/eso/certs/mib2-1-cert.pem"
								}
							}
					}
				},
				"tracing":{
					"mmx":{
						"mode":"resman",
						"serializer":"BE",
						"resman":{
							"root_path":"/dev/eso"
						}
					},
					"*":{
						"mode":"tcpip",
						"serializer":"BE",
						"tcpip":{
							"address":"10.0.0.15"
						}
					}
				},
				"logger":{
					"*":{
						"mode":"tcpip",
						"serializer":"BE",
						"tcpip":{
							"address":"0.0.0.0",
                            "no_delay":false
						}
					}
				}
			}
		},
		"rcc":{
			"transport":{
				"comm":{
					"*":{
						"mode":"tcpip",
						"serializer":"BE",
						"tcpip":{
							"address":"10.0.0.16"
						}
					}
				}
			}
		},
		"pcsim":{
			"transport":{
				"comm":{
					"*":{
						"mode":"tcpip",
						"serializer":"BE",
						"tcpip":{
							"address":"172.16.250.1"
						}
					}
				}
			}
		},
		"sdis":{
			"transport":{
				"comm":{
					"*":{
						"mode":"tcpip",
						"serializer":"BE",
						"tcpip":{
							"address":"0.0.0.0"
						}
					}
				}
			}
		}
