###########################################################################################
#
# Main -> M.I.B. -> MHI2Q CarPlay Route Guidance (mhi2q-carplay-rgi)
#
# Append this block to esd/Launcher-sda0.esd on the M.I.B. SD card.
# The submenu shows up automatically once the screen block is defined.
#
###########################################################################################
screen mhi2q_carplay_rgi =>M.I.B.<=

keyValue
    value   String sys 0x00000000 0
    label   "MHI2Q CarPlay Route Guidance patch by luka - VC + HUD + CoverArt"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "Turn-by-turn HUD/VC overlays, custom maneuver renderer, VC CoverArt fix"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "Files: libcarplay_hook.so, maneuver_render, flag_atlas, carplay_hook.jar"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "JSONs:  smartphone_integrator.json, dio_manager.json"
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   "Requires: MHI2Q hardware (any MU; built+tested on MU1316). CarPlay coded ON."
    poll    0

keyValue
    value   String sys 0x00000000 0
    label   " "
    poll    0

script
    value   sys 1 0x0100 "/net/mmx/fs/sda0/esd/scripts/mhi2q-carplay-rgi_check.sh"
    label   "Check: FW compat, marker, and SHA per component"

script
    value   sys 1 0x0100 "/net/mmx/fs/sda0/esd/scripts/mhi2q-carplay-rgi_install.sh"
    label   "Install (FW check; auto-uninstall first if already installed)"

script
    value   sys 1 0x0100 "/net/mmx/fs/sda0/esd/scripts/mhi2q-carplay-rgi_uninstall.sh"
    label   "Uninstall (restore originals from backup, remove added files)"

keyValue
    value   String sys 0x00000000 0
    label   "___________________________________________________________________________"
    poll    0
