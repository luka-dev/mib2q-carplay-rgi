#!/bin/sh
revision="MHI2Q CarPlay patch installer v0.1.0 (Route Guidance + VC CoverArt fix)"

export PATH=:/proc/boot:/sbin:/bin:/usr/bin:/usr/sbin:/net/mmx/bin:/net/mmx/usr/bin:/net/mmx/usr/sbin:/net/mmx/sbin:/net/mmx/mnt/app/armle/bin:/net/mmx/mnt/app/armle/sbin:/net/mmx/mnt/app/armle/usr/bin:/net/mmx/mnt/app/armle/usr/sbin
export LD_LIBRARY_PATH=/net/mmx/mnt/app/root/lib-target:/net/mmx/mnt/eso/lib:/net/mmx/eso/lib:/net/mmx/mnt/app/usr/lib:/net/mmx/mnt/app/armle/lib:/net/mmx/mnt/app/armle/lib/dll:/net/mmx/mnt/app/armle/usr/lib
export IPL_CONFIG_DIR=/etc/eso/production

thisname="$(basename $0)"
thisdir="$(dirname $0)"

if [ -z $LOG ]; then
    . $thisdir/../config/GLOBALS
fi
echo -ne "\n$ME-$thisname---->\n" | $TEE -i -a $LOG

if [ -f $TMP/backup.mib ] || [ -f $TMP/reboot.mib ] || [ -f $TMP/flash.mib ]; then
    echo "Backup or reboot is already running..." | $TEE -a $LOG
    return 2> /dev/null
fi

if [ "$2" = "-noboot" ]; then
    noboot=$2
else
    noboot=""
fi

PAYLOAD="$VOLUME/custom/mhi2q-carplay-rgi"
BUDIR="$BACKUPFOLDER/mhi2q-carplay-rgi"
HOOKDIR="/net/mmx/mnt/app/root/hooks"

# File-copy targets: label|payload_name|dst_path|mode
TARGETS="\
CHook|libcarplay_hook.so|/net/mmx/mnt/app/root/hooks/libcarplay_hook.so|755
Render|maneuver_render|/net/mmx/mnt/app/root/hooks/maneuver_render|755
Atlas|flag_atlas.rgba|/net/mmx/mnt/app/root/hooks/flag_atlas.rgba|644
Jar|carplay_hook.jar|/net/mmx/mnt/app/eso/hmi/lsd/jars/carplay_hook.jar|644"

# In-place JSON patches (sed-based, idempotent)
JSON_SI=/net/mmx/mnt/system/etc/eso/production/smartphone_integrator.json
JSON_DIO=/net/mmx/mnt/system/etc/eso/production/dio_manager.json
LDPRELOAD_LINE='"LD_PRELOAD=/mnt/app/root/hooks/libcarplay_hook.so"'

check_fw() {
    echo "FW check: TRAIN=$TRAINVERSION MU=$MUVERSION FAZIT=$FAZIT" | $TEE -a $LOG
    if [[ "$TRAINVERSION" != *MHI2Q* ]]; then
        echo "  ABORT: TRAINVERSION does not contain MHI2Q" | $TEE -a $LOG
        echo "  This patch is for MHI2Q hardware only (Qualcomm SoC variant)." | $TEE -a $LOG
        echo "  Old MHI2 (pre-Q) and MHIG (MIB1 High) are NOT supported." | $TEE -a $LOG
        return 1
    fi
    if [ "$MUVERSION" != "MU1316" ]; then
        echo "  WARN: patch was built for MU1316, you have $MUVERSION" | $TEE -a $LOG
        echo "  May still work but layout/symbols can differ - proceed at your own risk." | $TEE -a $LOG
    fi
    echo "  OK: $TRAINVERSION / $MUVERSION accepted" | $TEE -a $LOG
    return 0
}

mount_rw() {
    mount -uw /net/mmx/mnt/app 2>> $LOG
    mount -uw /net/mmx/mnt/system 2>> $LOG
}

json_backup() {
    F="$1"
    BU="$BUDIR/$(basename $F).orig"
    if [ ! -e "$BU" ] && [ -e "$F" ]; then
        echo "  [$(basename $F)] backup -> $BU" | $TEE -a $LOG
        cp -v "$F" "$BU" 2>> $LOG
    fi
}

patch_jsons() {
    echo "  --- JSON patches (in-place sed) ---" | $TEE -a $LOG

    # smartphone_integrator.json: inject LD_PRELOAD into carplay envs array
    # anchor on the IPL_CONFIG_DIR_DIO_MANAGER line (stock = last envs entry, no trailing comma)
    json_backup "$JSON_SI"
    if grep -q "libcarplay_hook.so" "$JSON_SI" 2>/dev/null; then
        echo "  [SIJson]  LD_PRELOAD already present - skip" | $TEE -a $LOG
    elif [ ! -e "$JSON_SI" ]; then
        echo "  [SIJson]  MISSING $JSON_SI - skip" | $TEE -a $LOG
    else
        echo "  [SIJson]  inject LD_PRELOAD after IPL_CONFIG_DIR_DIO_MANAGER" | $TEE -a $LOG
        $SED -ir 's|"IPL_CONFIG_DIR_DIO_MANAGER=/etc/eso/production"|"IPL_CONFIG_DIR_DIO_MANAGER=/etc/eso/production",\n        '"$LDPRELOAD_LINE"'|g' "$JSON_SI" 2>> $LOG
    fi

    # dio_manager.json: add RGD message IDs to two arrays inside carplay Identify
    # MessagesSentByAccessory: append after the last stock entry "0x4C05"
    # MessagesReceivedFromDevice: append after the last stock entry "0x4C04"
    json_backup "$JSON_DIO"
    if [ ! -e "$JSON_DIO" ]; then
        echo "  [DIOJson] MISSING $JSON_DIO - skip" | $TEE -a $LOG
        return 0
    fi
    if grep -q '"0x5200"' "$JSON_DIO"; then
        echo "  [DIOJson] 0x5200/0x5203 already in MessagesSentByAccessory - skip" | $TEE -a $LOG
    else
        echo "  [DIOJson] inject 0x5200/0x5203 into MessagesSentByAccessory" | $TEE -a $LOG
        $SED -ir '/"MessagesSentByAccessory"/,/]/ s|"0x4C05"|"0x4C05", "0x5200", "0x5203"|' "$JSON_DIO" 2>> $LOG
    fi
    if grep -q '"0x5201"' "$JSON_DIO"; then
        echo "  [DIOJson] 0x5201/0x5202/0x5204 already in MessagesReceivedFromDevice - skip" | $TEE -a $LOG
    else
        echo "  [DIOJson] inject 0x5201/0x5202/0x5204 into MessagesReceivedFromDevice" | $TEE -a $LOG
        $SED -ir '/"MessagesReceivedFromDevice"/,/]/ s|"0x4C04"|"0x4C04", "0x5201", "0x5202", "0x5204"|' "$JSON_DIO" 2>> $LOG
    fi
}

unpatch_jsons() {
    echo "  --- JSON restore (from .orig backups) ---" | $TEE -a $LOG
    for F in "$JSON_SI" "$JSON_DIO"; do
        BU="$BUDIR/$(basename $F).orig"
        if [ -e "$BU" ]; then
            echo "  [$(basename $F)] restore $BU -> $F" | $TEE -a $LOG
            cp -v "$BU" "$F" 2>> $LOG
            chmod 644 "$F" 2>> $LOG
        else
            echo "  [$(basename $F)] no backup, leave as is" | $TEE -a $LOG
        fi
    done
}

json_state() {
    # echoes one of: PATCHED | ORIGINAL | PARTIAL | MISSING
    F="$1"
    if [ ! -e "$F" ]; then
        echo "MISSING"; return
    fi
    case "$(basename $F)" in
        smartphone_integrator.json)
            grep -q "libcarplay_hook.so" "$F" && echo "PATCHED" || echo "ORIGINAL"
            ;;
        dio_manager.json)
            HAS_SENT=0; HAS_RECV=0
            grep -q '"0x5200"' "$F" && HAS_SENT=1
            grep -q '"0x5201"' "$F" && HAS_RECV=1
            if [ "$HAS_SENT" = 1 ] && [ "$HAS_RECV" = 1 ]; then
                echo "PATCHED"
            elif [ "$HAS_SENT" = 0 ] && [ "$HAS_RECV" = 0 ]; then
                echo "ORIGINAL"
            else
                echo "PARTIAL"
            fi
            ;;
    esac
}

do_install() {
    echo "--- Installing MHI2Q CarPlay Route Guidance patch ---" | $TEE -a $LOG
    check_fw || { echo "Aborted." | $TEE -a $LOG; return 2> /dev/null; }
    mount_rw
    if [ -f "$BUDIR/.installed" ]; then
        echo "Patch is already installed - running uninstall first." | $TEE -a $LOG
        echo "$(cat $BUDIR/.installed)" | $TEE -a $LOG
        do_uninstall_inner
        echo "--- Proceeding with fresh install ---" | $TEE -a $LOG
    fi
    mkdir -p "$BUDIR" 2>/dev/null
    mkdir -p "$HOOKDIR" 2>> $LOG
    chmod 755 "$HOOKDIR" 2>> $LOG
    echo "$TARGETS" | while IFS='|' read NAME SRC DST MODE; do
        [ -z "$NAME" ] && continue
        if [ ! -f "$PAYLOAD/$SRC" ]; then
            echo "  [$NAME] MISSING payload $PAYLOAD/$SRC - skip" | $TEE -a $LOG
            continue
        fi
        BU="$BUDIR/$(basename $DST).orig"
        if [ ! -e "$BU" ] && [ -e "$DST" ]; then
            echo "  [$NAME] backup -> $BU" | $TEE -a $LOG
            cp -v "$DST" "$BU" 2>> $LOG
        fi
        echo "  [$NAME] install $SRC -> $DST (mode $MODE)" | $TEE -a $LOG
        cp -v "$PAYLOAD/$SRC" "$DST" 2>> $LOG
        chmod "$MODE" "$DST" 2>> $LOG
    done
    patch_jsons
    echo "$revision $($TIMESTAMP) TRAIN=$TRAINVERSION MU=$MUVERSION" > "$BUDIR/.installed"
    echo "--- Done. Rebooting in 10s ---" | $TEE -a $LOG
    [ -z "$noboot" ] && . $thisdir/reboot -t 10
    return 2> /dev/null
}

do_uninstall_inner() {
    if [ ! -d "$BUDIR" ]; then
        echo "  no backup folder $BUDIR - nothing to restore" | $TEE -a $LOG
        return 0
    fi
    echo "$TARGETS" | while IFS='|' read NAME SRC DST MODE; do
        [ -z "$NAME" ] && continue
        BU="$BUDIR/$(basename $DST).orig"
        if [ -e "$BU" ]; then
            echo "  [$NAME] restore $BU -> $DST" | $TEE -a $LOG
            cp -v "$BU" "$DST" 2>> $LOG
            chmod "$MODE" "$DST" 2>> $LOG
        else
            # No backup means file didn't exist on stock (e.g. libcarplay_hook.so in /hooks).
            # Remove added file so uninstall leaves a clean stock state.
            if [ -e "$DST" ] && [[ "$DST" == *"/hooks/"* ]]; then
                echo "  [$NAME] no backup, remove added file $DST" | $TEE -a $LOG
                rm -f "$DST" 2>> $LOG
            else
                echo "  [$NAME] no backup, skip" | $TEE -a $LOG
            fi
        fi
    done
    unpatch_jsons
    rm -f "$BUDIR/.installed"
    return 0
}

do_uninstall() {
    echo "--- Uninstalling MHI2Q CarPlay Route Guidance patch ---" | $TEE -a $LOG
    mount_rw
    do_uninstall_inner
    echo "--- Done. Rebooting in 10s ---" | $TEE -a $LOG
    [ -z "$noboot" ] && . $thisdir/reboot -t 10
    return 2> /dev/null
}

do_check() {
    echo "--- MHI2Q CarPlay Route Guidance patch check ---" | $TEE -a $LOG
    echo "TRAIN=$TRAINVERSION  MU=$MUVERSION  FAZIT=$FAZIT" | $TEE -a $LOG
    if [[ "$TRAINVERSION" = *MHI2Q* ]]; then
        if [ "$MUVERSION" = "MU1316" ]; then
            echo "FW: SUPPORTED (MHI2Q $MUVERSION - built target)" | $TEE -a $LOG
        else
            echo "FW: SUPPORTED with WARN (MHI2Q $MUVERSION - not built target MU1316)" | $TEE -a $LOG
        fi
    else
        echo "FW: UNSUPPORTED (not MHI2Q - this patch is Qualcomm-variant only)" | $TEE -a $LOG
    fi
    if [ -f "$BUDIR/.installed" ]; then
        echo "Marker: $(cat $BUDIR/.installed)" | $TEE -a $LOG
    else
        echo "Marker: NOT installed" | $TEE -a $LOG
    fi
    echo "Files (SHA1[0:12] dst / payload / backup):" | $TEE -a $LOG
    echo "$TARGETS" | while IFS='|' read NAME SRC DST MODE; do
        [ -z "$NAME" ] && continue
        BU="$BUDIR/$(basename $DST).orig"
        if [ -e "$DST" ]; then
            SHA_DST=$($SHA1 "$DST" | $CUT -c1-12)
        else
            SHA_DST="----missing"
        fi
        if [ -e "$PAYLOAD/$SRC" ]; then
            SHA_PL=$($SHA1 "$PAYLOAD/$SRC" | $CUT -c1-12)
        else
            SHA_PL="----missing"
        fi
        if [ -e "$BU" ]; then
            SHA_BU=$($SHA1 "$BU" | $CUT -c1-12)
        else
            SHA_BU="----nobackup"
        fi
        MATCH="?"
        [ "$SHA_DST" = "$SHA_PL" ] && MATCH="PATCHED"
        [ "$SHA_DST" = "$SHA_BU" ] && MATCH="ORIGINAL"
        printf "  %-8s dst=%s pl=%s bu=%s [%s]\n" "$NAME" "$SHA_DST" "$SHA_PL" "$SHA_BU" "$MATCH" | $TEE -a $LOG
    done
    echo "JSON patches:" | $TEE -a $LOG
    SI_STATE=$(json_state "$JSON_SI")
    DIO_STATE=$(json_state "$JSON_DIO")
    SI_BU="$BUDIR/$(basename $JSON_SI).orig"
    DIO_BU="$BUDIR/$(basename $JSON_DIO).orig"
    [ -e "$SI_BU" ]  && SI_BUMARK="bu-saved"  || SI_BUMARK="no-bu"
    [ -e "$DIO_BU" ] && DIO_BUMARK="bu-saved" || DIO_BUMARK="no-bu"
    printf "  %-8s state=%-8s (%s)\n" "SIJson"  "$SI_STATE"  "$SI_BUMARK"  | $TEE -a $LOG
    printf "  %-8s state=%-8s (%s)\n" "DIOJson" "$DIO_STATE" "$DIO_BUMARK" | $TEE -a $LOG
    return 2> /dev/null
}

case $1 in
    -i) do_install ;;
    -u) do_uninstall ;;
    -c) do_check ;;
    *)
        echo ""
        echo $revision
        echo ""
        echo "Usage: $thisname [OPTION1] [-noboot]"
        echo ""
        echo "Options:"
        echo "  -c         check (FW compat + SHA-compare payload/target/backup)"
        echo "  -i         install (FW check, auto-uninstall if marker present, then deploy)"
        echo "  -u         uninstall (restore originals, remove added files in /hooks/)"
        echo "  -noboot    no reboot triggered by script"
        echo ""
    ;;
esac

exit 0
