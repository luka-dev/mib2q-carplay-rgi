{
  "application": {
    "arrays": {
      "experiments": "experiment",
      "introFlow": "section",
      "modalDialogs": "banner",
      "products": "product",
      "promotions": "promotion",
      "sections": "section"
    },
    "key": "name"
  },
  "banner": {
    "arrays": { "buttons": "button" },
    "fields": [ "type", "action", "title", "subtitle", "body", "backgroundImage", "isOffline" ],
    "key": "name"
  },
  "button": {
    "fields": [ "label", "action", "icon" ],
    "key": "name"
  },
  "collection": {
    "arrays": { "items": "video" },
    "fields": [ "title", "isPortrais", "isContinuousPlayback" ],
    "key": "name"
  },
  "experiment": {
    "arrays": {
      "banners": "banner",
      "sections": "section"
    },
    "fields": [ "type", "projectID", "language", "viewEventName", "primaryConversionEvent", "secondaryConversionEvent", "tertiaryConversionEvent" ],
    "key": "name"
  },
  "expirationNotice": {
    "fields": [ "heading", "body", "daysRemaining" ],
    "key": "title"
  },
  "label": {
    "fields": [ "text" ],
    "key": "name"
  },
  "product": {
    "arrays": { "expirationNotices": "expirationNotice" },
    "key": "identifier"
  },
  "promotion": {
    "arrays": {
      "banners": "banners",
      "sections": "section"
    },
    "fields": [ "beginDate", "endDate" ],
    "key": "name"
  },
  "section": {
    "arrays": {
      "banners": "banner",
      "buttons": "button",
      "labels": "label",
      "rows": "collection"
    },
    "fields": [ "template", "title", "subtitle", "body", "backgroundImage", "isOffline" ],
    "key": "name",
    "references": {
      "carousel": "collection"
    }
  },
  "video": {
    "fields": [ "title", "thumbnail", "shortDescription", "longDescription", "videoManifestFilename", "action", "runtimeSeconds", "isAtmos", "isVision", "IsAudio", "isOffline" ],
    "key": "id"
  }
}