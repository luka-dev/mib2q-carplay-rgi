diff --git a/hw/misc/apple-silicon/tristar-lab.c b/hw/misc/apple-silicon/tristar-lab.c
new file mode 100644
index 0000000..a2bb494
--- /dev/null
+++ b/hw/misc/apple-silicon/tristar-lab.c
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+/* Opt-in register-level Tristar bring-up model; no accessory authentication. */
+#include "qemu/osdep.h"
+#include "hw/i2c/i2c.h"
+#include "hw/qdev-core.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+#include "tristar-lab-regs.h"
+
+typedef struct LabTristar {
+    I2CSlave parent_obj;
+    LabTristarRegs state;
+    unsigned trace_count;
+} LabTristar;
+
+static void tristar_trace(LabTristar *s, const char *op, uint8_t reg, uint8_t value)
+{
+    if (!g_strcmp0(g_getenv("MHI2_IOS_VM_TRISTAR_TRACE"), "1") &&
+        s->trace_count < 256) {
+        s->trace_count++;
+        fprintf(stderr, "lab-tristar: %s reg=%02x value=%02x\n", op, reg, value);
+    }
+}
+
+static uint8_t tristar_read(I2CSlave *dev)
+{
+    LabTristar *s = (LabTristar *)dev;
+    uint8_t reg = s->state.index;
+    uint8_t value = lab_tristar_read(&s->state);
+    tristar_trace(s, "read", reg, value);
+    return value;
+}
+
+static int tristar_write(I2CSlave *dev, uint8_t value)
+{
+    LabTristar *s = (LabTristar *)dev;
+    if (!s->state.address_pending) {
+        tristar_trace(s, "write", s->state.index, value);
+    }
+    lab_tristar_write(&s->state, value);
+    return 0;
+}
+
+static int tristar_event(I2CSlave *dev, enum i2c_event event)
+{
+    LabTristar *s = (LabTristar *)dev;
+    if (event == I2C_START_SEND) {
+        lab_tristar_start_send(&s->state);
+    }
+    return 0;
+}
+
+static void tristar_reset(DeviceState *dev)
+{
+    LabTristar *s = (LabTristar *)dev;
+    /* AppleCBTL1610::readSystemID reads 5d..5f and checks the 74 marker. */
+    lab_tristar_reset(&s->state);
+    s->trace_count = 0;
+}
+
+static const VMStateDescription tristar_vmstate = {
+    .name = "mhi2-lab-tristar",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_I2C_SLAVE(parent_obj, LabTristar),
+        VMSTATE_UINT8_ARRAY(state.regs, LabTristar, 256),
+        VMSTATE_UINT8(state.index, LabTristar),
+        VMSTATE_BOOL(state.address_pending, LabTristar),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void tristar_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *i2c = I2C_SLAVE_CLASS(klass);
+    dc->desc = "Opt-in synthetic Tristar register probe";
+    dc->user_creatable = false;
+    dc->vmsd = &tristar_vmstate;
+    device_class_set_legacy_reset(dc, tristar_reset);
+    i2c->recv = tristar_read;
+    i2c->send = tristar_write;
+    i2c->event = tristar_event;
+}
+
+static const TypeInfo tristar_type = {
+    .name = "mhi2-lab-tristar",
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(LabTristar),
+    .class_init = tristar_class_init
+};
+
+static void tristar_register_types(void)
+{
+    type_register_static(&tristar_type);
+}
+type_init(tristar_register_types);
diff --git a/hw/misc/apple-silicon/tristar-lab-regs.h b/hw/misc/apple-silicon/tristar-lab-regs.h
new file mode 100644
index 0000000..430e6f4
--- /dev/null
+++ b/hw/misc/apple-silicon/tristar-lab-regs.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+#ifndef MHI2_TRISTAR_LAB_REGS_H
+#define MHI2_TRISTAR_LAB_REGS_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+typedef struct LabTristarRegs {
+    uint8_t regs[256];
+    uint8_t index;
+    bool address_pending;
+} LabTristarRegs;
+
+static inline void lab_tristar_reset(LabTristarRegs *s)
+{
+    memset(s, 0, sizeof(*s));
+    s->regs[0x5f] = 0x74;
+    s->address_pending = true;
+}
+
+static inline void lab_tristar_start_send(LabTristarRegs *s)
+{
+    s->address_pending = true;
+}
+
+static inline void lab_tristar_write(LabTristarRegs *s, uint8_t value)
+{
+    if (s->address_pending) {
+        s->index = value;
+        s->address_pending = false;
+    } else {
+        uint8_t reg = s->index++;
+        if (reg != 0x5f) {
+            s->regs[reg] = value;
+        }
+    }
+}
+
+static inline uint8_t lab_tristar_read(LabTristarRegs *s)
+{
+    return s->regs[s->index++];
+}
+#endif

