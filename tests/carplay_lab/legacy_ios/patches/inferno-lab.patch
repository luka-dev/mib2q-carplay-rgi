diff --git a/hw/arm/apple-silicon/mt-spi-motion.h b/hw/arm/apple-silicon/mt-spi-motion.h
new file mode 100644
--- /dev/null
+++ b/hw/arm/apple-silicon/mt-spi-motion.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+#ifndef APPLE_MT_SPI_MOTION_H
+#define APPLE_MT_SPI_MOTION_H
+#include <stdint.h>
+
+static inline uint16_t apple_mt_spi_velocity_ns(int32_t delta, uint64_t dt_ns)
+{
+    uint64_t magnitude = delta < 0 ? (uint64_t)-(int64_t)delta : (uint64_t)delta;
+    if (!dt_ns) {
+        return 0;
+    }
+    uint64_t velocity = magnitude * 1000000000ULL / dt_ns;
+    return velocity > UINT16_MAX ? UINT16_MAX : (uint16_t)velocity;
+}
+#endif
