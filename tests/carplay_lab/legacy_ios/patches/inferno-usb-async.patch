+                }
+                if (rhdr.status == USB_RET_NAK) {
+                    pkt->retry_pending = true;
+                    timer_mod(s->retry_timer,
+                              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 1);
+                }
+                return true;
+            }
+            p->status = rhdr.status;
+            if (p->status != USB_RET_SUCCESS && p->ep->nr == 0 &&
