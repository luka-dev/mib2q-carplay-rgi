+static bool usb_tcp_remote_send_deferred(USBTCPRemoteState *s,
+                                         USBTCPInflightPacket *entry)
+{
+    USBPacket *p = entry->p;
+    tcp_usb_header_t hdr = { .type = TCP_USB_REQUEST };
+    tcp_usb_request_header pkt = {
+        .addr = s->addr, .pid = p->pid, .ep = p->ep->nr, .id = entry->wire_id,
+        .stream = p->stream, .short_not_ok = p->short_not_ok,
+        .int_req = p->int_req, .length = p->iov.size - p->actual_length,
+    };
+    g_autofree void *buffer = NULL;
+    assert(bql_locked());
+    if (p->pid != USB_TOKEN_IN && pkt.length) {
+        buffer = g_malloc0(pkt.length);
+        usb_packet_copy(p, buffer, pkt.length);
+        p->actual_length -= pkt.length;
+        if (p->pid == USB_TOKEN_SETUP && !p->ep->nr) {
+            struct usb_control_packet *setup = buffer;
+            if (pkt.length == sizeof(*setup) && !setup->bmRequestType &&
+                setup->bRequest == USB_REQ_SET_ADDRESS) {
+                s->addr = setup->wValue;
+            }
+        }
+    }
+    WITH_QEMU_LOCK_GUARD(&s->request_mutex) {
+        if (usb_tcp_remote_write(s, &hdr, sizeof(hdr)) != sizeof(hdr) ||
+            usb_tcp_remote_write(s, &pkt, sizeof(pkt)) != sizeof(pkt) ||
+            (buffer && usb_tcp_remote_write(s, buffer, pkt.length) != pkt.length)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void usb_tcp_remote_retry(void *opaque)
+{
+    USBTCPRemoteState *s = opaque;
+    USBTCPInflightPacket *p;
+    assert(bql_locked());
+    if (s->closed) {
+        return;
+    }
+    /* The BQL protects packet lifetimes. Sending must not hold queue_mutex:
+     * a failed socket write closes the connection and drains this queue. */
+    QTAILQ_FOREACH(p, &s->queue, queue) {
+        if (p->deferred && p->retry_pending) {
+            p->retry_pending = false;
+            if (!usb_tcp_remote_send_deferred(s, p)) {
+                return;
+            }
+        }
+    }
+}
