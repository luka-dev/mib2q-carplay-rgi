.idea/
.claude/
.venv*/
**/.DS_Store
*.o
/build/java/
/build/libcarplay_hook.so
/build/libcarplay_apac.so
/build/apple_apac_oracle
/build/qsa_play
/local_logs/
/log/
tools/loader_preview/loader_preview

# Phone-side captures: sysdiagnose tarballs and log archives are hundreds of MB
# and contain the owner's device logs. Keep them local.
/logs/

# tools/keys holds analysis key material. Default is to keep it out of history —
# live AirPlay session keys (`shk`) must never be committed. Public values
# extracted from donor firmware are opted back in individually.
/tools/keys/*
!/tools/keys/README.md
!/tools/keys/*_rsa_modulus.hex
__pycache__/
.ida-mcp/

# Live CarPlay session captures. The SETUP plist carries the 32-byte `shk`
# session key in plaintext — never commit it. Keep captures local, mode 0600.
/captures/

# Test binaries built by scripts/run_tests.sh.
/build/tests/
