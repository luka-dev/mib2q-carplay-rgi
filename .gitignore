.idea/
.claude/
.venv*/
**/.DS_Store
*.o

# Build output. Everything under build/ is produced by scripts/build_*.sh, so the
# tree carries the directory and nothing else.
/build/*
!/build/.gitkeep
# HSSR Universal cannot be reproduced on a clean checkout without its selected
# runtime weights.  Keep only the shipping V11 binary; training checkpoints and
# all other build output remain ignored.
!/build/hssr-selection-v11/
/build/hssr-selection-v11/*
!/build/hssr-selection-v11/hssr_model.bin
/local_logs/
/log/
tools/loader_preview/loader_preview

# Phone-side captures: sysdiagnose tarballs and log archives are hundreds of MB
# and contain the owner's device logs. Keep them local.
/logs/

# tools/keys holds analysis key material. Default is to keep it out of history —
# live AirPlay session keys (`shk`) must never be committed. Public values
# extracted from donor firmware are opted back in individually.
/tools/keys/*
!/tools/keys/README.md
!/tools/keys/*_rsa_modulus.hex
__pycache__/
.ida-mcp/

# Live CarPlay session captures. The SETUP plist carries the 32-byte `shk`
# session key in plaintext — never commit it. Keep captures local, mode 0600.
/captures/

# IDA unpacks its database beside the .i64 while a session is open
*.id0
*.id1
*.id2
*.nam
*.til

# Clang diagnostic artifacts and scratch downloads, never part of a build.
/stereo_upmix.plist
/stereo_upmix_render.plist
tmp/

# Local editor/compiler state, not project data.
~$*.xlsx
*.tsbuildinfo
*.dSYM/

# Share-review sources/reports are retained; compiled test programs are not.
/output/share-review/**/check_*
!/output/share-review/**/check_*.c
!/output/share-review/**/check_*.h
/output/share-review/**/*.dylib
/output/share-review/**/video_receiver
/output/share-review/**/stage/hook/build/

# Isolated renderer experiment: retain evidence, exclude binaries/copied runtime atlas.
/output/arrow-progress/host/
/output/arrow-progress/frames/flag_atlas.rgba
